# ─── Database (Postgres / Supabase) ──────────────────────────────────────────────
# Pooled connection used by the app at runtime (PgBouncer / Supabase pooler, port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection used by Prisma Migrate / CLI (port 5432).
# Required: prisma.config.ts reads this for migrations. Set it even if it equals DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# IMPORTANT: do NOT wrap NEXT_PUBLIC_* values in quotes. They are inlined into the client
# bundle verbatim, so the quotes become part of the value there — e.g. NEXT_PUBLIC_CLOUD_SYNC="1"
# makes the browser compare '"1"' against '1' and the feature silently stays off. Server-only vars
# (DATABASE_URL, ANTHROPIC_API_KEY, ARTHVO_DATA_ENC_KEY) read at runtime and may be quoted.

# ─── Auth (Supabase) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ─── AI ──────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── App ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=ArthSaathi

# ─── BUG-8 cloud persistence (privacy model B+) ──────────────────────────────────
# Feature flag for per-user cloud sync. OFF by default; set to 1 (unquoted) to enable the
# SyncProvider + /api/user-data route. Do NOT enable until real auth + the UserData
# migration are in place.
NEXT_PUBLIC_CLOUD_SYNC=0
# Server-side AES-256-GCM key for encrypting the synced blob (and PAN/Aadhaar) at rest.
# 32 random bytes as base64 or hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ARTHVO_DATA_ENC_KEY=""
